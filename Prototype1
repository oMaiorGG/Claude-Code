import { useState, useCallback } from 'react';
import Header from '@/components/Header';
import BottomNavigation, { type NavPage } from '@/components/BottomNavigation';
import HomePage from '@/pages/HomePage';
import CardPage from '@/pages/CardPage';
import ActivitiesPage from '@/pages/ActivitiesPage';
import BenefitsPage from '@/pages/BenefitsPage';
import ProfilePage from '@/pages/ProfilePage';
import LoginPage from '@/pages/LoginPage';
import AdminDashboardPage from '@/pages/AdminDashboardPage';
import { AppProvider, useApp } from '@/context/AppContext';

type Page = NavPage | 'profile';

function AppShell() {
  const { currentUser, getCurrentMember, notifications } = useApp();
  const [page, setPage] = useState<Page>('home');
  const [selectedEventId, setSelectedEventId] = useState<string | null>(null);
  const [selectedBenefitId, setSelectedBenefitId] = useState<string | null>(null);

  const handleNavigate = useCallback((p: NavPage) => {
    setPage(p);
    setSelectedEventId(null);
    setSelectedBenefitId(null);
  }, []);

  const handleProfile = useCallback(() => setPage('profile'), []);
  const handleBack = useCallback(() => setPage('home'), []);

  const handleEventMore = useCallback((eventId: string) => {
    setSelectedEventId(eventId);
    setPage('activities');
  }, []);

  const handleBenefitOpen = useCallback((benefitId: string) => {
    setSelectedBenefitId(benefitId);
    setPage('benefits');
  }, []);

  const handleNotificationOpen = useCallback((notifId: string) => {
    const notif = notifications.find((n) => n.id === notifId);
    if (!notif?.link) return;
    if (notif.link.startsWith('act-')) handleEventMore(notif.link);
    else if (notif.link.startsWith('ben-')) handleBenefitOpen(notif.link);
  }, [notifications, handleEventMore, handleBenefitOpen]);

  if (!currentUser) {
    return <LoginPage onSuccess={() => setPage('home')} />;
  }

  if (currentUser.role === 'admin') {
    return <AdminDashboardPage onLogout={() => setPage('home')} />;
  }

  const member = getCurrentMember();
  const showBottomNav = page !== 'profile';
  const showBack = page === 'card' || page === 'profile';
  const headerTitle = page === 'card' ? 'Meu Cartão' : page === 'profile' ? 'O Meu Perfil' : undefined;

  return (
    <div className="page-container flex flex-col">
      <Header
        title={headerTitle}
        showBack={showBack}
        onBack={handleBack}
        onProfile={page !== 'profile' ? handleProfile : undefined}
        avatarInitials={member?.avatarInitials}
      />

      <main className="flex-1 overflow-y-auto no-scrollbar pb-2">
        {page === 'home' && (
          <HomePage
            onNavigate={handleNavigate}
            onEventMore={handleEventMore}
            onBenefitOpen={handleBenefitOpen}
            onNotificationOpen={handleNotificationOpen}
            onProfile={handleProfile}
          />
        )}
        {page === 'card' && <CardPage onBack={handleBack} />}
        {page === 'activities' && (
          <ActivitiesPage
            selectedEventId={selectedEventId}
            onClearSelected={() => setSelectedEventId(null)}
          />
        )}
        {page === 'benefits' && (
          <BenefitsPage
            selectedBenefitId={selectedBenefitId}
            onClearSelected={() => setSelectedBenefitId(null)}
          />
        )}
        {page === 'profile' && <ProfilePage onBack={handleBack} />}
      </main>

      {showBottomNav && (
        <BottomNavigation current={page as NavPage} onNavigate={handleNavigate} />
      )}
    </div>
  );
}

export default function App() {
  return (
    <AppProvider>
      <AppShell />
    </AppProvider>
  );
}

