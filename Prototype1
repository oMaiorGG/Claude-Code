import { createContext, useContext, useState, useCallback, useEffect, type ReactNode } from 'react';
import type {
  Member,
  Quota,
  Activity,
  ActivityRegistration,
  Benefit,
  Notification,
  AuthUser,
} from '@/types';
import {
  membersData,
  quotasData,
  activitiesData,
  registrationsData,
  benefitsData,
  notificationsData,
  DEMO_MEMBER_ID,
  DEMO_MEMBER_EMAIL,
  DEMO_ADMIN_EMAIL,
} from '@/data/mockData';

const SESSION_KEY = 'acb_session';

function readStoredSession(): { email: string } | null {
  try {
    const raw = localStorage.getItem(SESSION_KEY) ?? sessionStorage.getItem(SESSION_KEY);
    return raw ? JSON.parse(raw) : null;
  } catch {
    return null;
  }
}

function writeStoredSession(email: string, remember: boolean) {
  try {
    const payload = JSON.stringify({ email });
    if (remember) {
      localStorage.setItem(SESSION_KEY, payload);
      sessionStorage.removeItem(SESSION_KEY);
    } else {
      sessionStorage.setItem(SESSION_KEY, payload);
      localStorage.removeItem(SESSION_KEY);
    }
  } catch {
    // armazenamento indisponível (ex. navegação privada) — sessão simplesmente não persiste
  }
}

function clearStoredSession() {
  try {
    localStorage.removeItem(SESSION_KEY);
    sessionStorage.removeItem(SESSION_KEY);
  } catch {
    // ignore
  }
}

interface AppContextValue {
  // Auth
  currentUser: AuthUser | null;
  login: (email: string, remember?: boolean) => boolean;
  logout: () => void;

  // Data
  members: Member[];
  quotas: Quota[];
  activities: Activity[];
  registrations: ActivityRegistration[];
  benefits: Benefit[];
  notifications: Notification[];

  // Member mutations
  updateMember: (id: string, updates: Partial<Member>) => void;
  setMemberStatus: (id: string, status: Member['estadoAssociado']) => void;
  createMember: (member: Member) => void;

  // Quota mutations
  updateQuotaStatus: (quotaId: string, estado: Quota['estado']) => void;
  updateQuotaValor: (quotaId: string, valor: number) => void;

  // Activity mutations
  createActivity: (activity: Activity) => void;
  updateActivity: (id: string, updates: Partial<Activity>) => void;
  setActivityRegistrationStatus: (id: string, status: Activity['estadoInscricoes']) => void;
  registerForActivity: (activityId: string, memberId: string) => void;
  cancelRegistration: (registrationId: string) => void;
  getMemberRegistration: (activityId: string, memberId: string) => ActivityRegistration | undefined;

  // Benefit mutations
  createBenefit: (benefit: Benefit) => void;
  updateBenefit: (id: string, updates: Partial<Benefit>) => void;
  setBenefitStatus: (id: string, estado: Benefit['estado']) => void;

  // Notification mutations
  createNotification: (notif: Notification) => void;
  toggleNotificationPublished: (id: string) => void;

  // Helpers
  getCurrentMember: () => Member | undefined;
  getCurrentMemberQuota: () => Quota | undefined;
}

const AppContext = createContext<AppContextValue | null>(null);

export function AppProvider({ children }: { children: ReactNode }) {
  const [currentUser, setCurrentUser] = useState<AuthUser | null>(null);
  const [members, setMembers] = useState<Member[]>([...membersData]);
  const [quotas, setQuotas] = useState<Quota[]>([...quotasData]);
  const [activities, setActivities] = useState<Activity[]>([...activitiesData]);
  const [registrations, setRegistrations] = useState<ActivityRegistration[]>([...registrationsData]);
  const [benefits, setBenefits] = useState<Benefit[]>([...benefitsData]);
  const [notifications, setNotifications] = useState<Notification[]>([...notificationsData]);

  const resolveUser = useCallback((email: string): AuthUser | null => {
    const lower = email.toLowerCase().trim();
    if (lower === DEMO_ADMIN_EMAIL) {
      return { id: 'adm-001', nome: 'Administrador ACB', email: lower, role: 'admin' };
    }
    const member = members.find((m) => m.email.toLowerCase() === lower);
    if (member) {
      return { id: member.id, nome: member.nomeCompleto, email: member.email, role: 'member', memberRef: member.id };
    }
    return null;
  }, [members]);

  useEffect(() => {
    const stored = readStoredSession();
    if (stored) {
      const user = resolveUser(stored.email);
      if (user) setCurrentUser(user);
    }
    // apenas na montagem inicial
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  const login = useCallback((email: string, remember = false): boolean => {
    const user = resolveUser(email);
    if (!user) return false;
    setCurrentUser(user);
    writeStoredSession(user.email, remember);
    return true;
  }, [resolveUser]);

  const logout = useCallback(() => {
    setCurrentUser(null);
    clearStoredSession();
  }, []);

  const updateMember = useCallback((id: string, updates: Partial<Member>) => {
    setMembers((prev) => prev.map((m) => (m.id === id ? { ...m, ...updates } : m)));
  }, []);

  const setMemberStatus = useCallback((id: string, status: Member['estadoAssociado']) => {
    updateMember(id, { estadoAssociado: status });
  }, [updateMember]);

  const createMember = useCallback((member: Member) => {
    setMembers((prev) => [...prev, member]);
  }, []);

  const updateQuotaStatus = useCallback((quotaId: string, estado: Quota['estado']) => {
    setQuotas((prev) => prev.map((q) => {
      if (q.id !== quotaId) return q;
      return {
        ...q,
        estado,
        dataPagamento: estado === 'regularizada' ? new Date().toISOString().split('T')[0] : null,
      };
    }));
  }, []);

  const updateQuotaValor = useCallback((quotaId: string, valor: number) => {
    setQuotas((prev) => prev.map((q) => (q.id === quotaId ? { ...q, valor } : q)));
  }, []);

  const createActivity = useCallback((activity: Activity) => {
    setActivities((prev) => [...prev, activity]);
  }, []);

  const updateActivity = useCallback((id: string, updates: Partial<Activity>) => {
    setActivities((prev) => prev.map((a) => (a.id === id ? { ...a, ...updates } : a)));
  }, []);

  const setActivityRegistrationStatus = useCallback((id: string, status: Activity['estadoInscricoes']) => {
    updateActivity(id, { estadoInscricoes: status });
  }, [updateActivity]);

  const registerForActivity = useCallback((activityId: string, memberId: string) => {
    const existing = registrations.find(
      (r) => r.atividadeId === activityId && r.associadoId === memberId && r.estado === 'inscrito'
    );
    if (existing) return;

    const activity = activities.find((a) => a.id === activityId);
    if (!activity) return;

    const estado = activity.numeroInscritos >= activity.limiteParticipantes
      ? 'lista_espera'
      : 'inscrito';

    const newReg: ActivityRegistration = {
      id: `reg-${Date.now()}`,
      atividadeId: activityId,
      associadoId: memberId,
      dataInscricao: new Date().toISOString().split('T')[0],
      estado,
    };
    setRegistrations((prev) => [...prev, newReg]);

    const newCount = activity.numeroInscritos + 1;
    setActivities((prev) => prev.map((a) =>
      a.id === activityId
        ? {
            ...a,
            numeroInscritos: newCount,
            estadoInscricoes: newCount >= a.limiteParticipantes ? 'full' : a.estadoInscricoes,
          }
        : a
    ));
  }, [activities, registrations]);

  const cancelRegistration = useCallback((registrationId: string) => {
    setRegistrations((prev) => {
      const reg = prev.find((r) => r.id === registrationId);
      if (reg) {
        const activity = activities.find((a) => a.id === reg.atividadeId);
        if (activity) {
          const newCount = Math.max(0, activity.numeroInscritos - 1);
          setActivities((acts) => acts.map((a) =>
            a.id === reg.atividadeId
              ? {
                  ...a,
                  numeroInscritos: newCount,
                  estadoInscricoes: a.estadoInscricoes === 'full' && newCount < a.limiteParticipantes
                    ? 'open'
                    : a.estadoInscricoes,
                }
              : a
          ));
        }
      }
      return prev.map((r) => (r.id === registrationId ? { ...r, estado: 'cancelado' as const } : r));
    });
  }, [activities]);

  const getMemberRegistration = useCallback((activityId: string, memberId: string) => {
    return registrations.find(
      (r) => r.atividadeId === activityId && r.associadoId === memberId && r.estado === 'inscrito'
    );
  }, [registrations]);

  const createBenefit = useCallback((benefit: Benefit) => {
    setBenefits((prev) => [...prev, benefit]);
  }, []);

  const updateBenefit = useCallback((id: string, updates: Partial<Benefit>) => {
    setBenefits((prev) => prev.map((b) => (b.id === id ? { ...b, ...updates } : b)));
  }, []);

  const setBenefitStatus = useCallback((id: string, estado: Benefit['estado']) => {
    updateBenefit(id, { estado });
  }, [updateBenefit]);

  const createNotification = useCallback((notif: Notification) => {
    setNotifications((prev) => [...prev, notif]);
  }, []);

  const toggleNotificationPublished = useCallback((id: string) => {
    setNotifications((prev) => prev.map((n) => (n.id === id ? { ...n, publicada: !n.publicada } : n)));
  }, []);

  const getCurrentMember = useCallback(() => {
    if (!currentUser || currentUser.role !== 'member') return undefined;
    return members.find((m) => m.id === currentUser.memberRef);
  }, [currentUser, members]);

  const getCurrentMemberQuota = useCallback(() => {
    const member = getCurrentMember();
    if (!member) return undefined;
    const year = new Date().getFullYear();
    return quotas.find((q) => q.associadoId === member.id && q.ano === year);
  }, [getCurrentMember, quotas]);

  const value: AppContextValue = {
    currentUser,
    login,
    logout,
    members,
    quotas,
    activities,
    registrations,
    benefits,
    notifications,
    updateMember,
    setMemberStatus,
    createMember,
    updateQuotaStatus,
    updateQuotaValor,
    createActivity,
    updateActivity,
    setActivityRegistrationStatus,
    registerForActivity,
    cancelRegistration,
    getMemberRegistration,
    createBenefit,
    updateBenefit,
    setBenefitStatus,
    createNotification,
    toggleNotificationPublished,
    getCurrentMember,
    getCurrentMemberQuota,
  };

  return <AppContext.Provider value={value}>{children}</AppContext.Provider>;
}

export function useApp() {
  const ctx = useContext(AppContext);
  if (!ctx) throw new Error('useApp must be used within AppProvider');
  return ctx;
}


