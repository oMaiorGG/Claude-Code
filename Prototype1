import { useState, useCallback } from 'react';
import { useApp } from '@/context/AppContext';
import MembershipCard from '@/components/MembershipCard';
import StatusBadge from '@/components/StatusBadge';
import { Wallet, Download } from 'lucide-react';

interface CardPageProps {
  onBack: () => void;
}

export default function CardPage({ onBack }: CardPageProps) {
  const { getCurrentMember, getCurrentMemberQuota } = useApp();
  const member = getCurrentMember();
  const quota = getCurrentMemberQuota();
  const [qrDataUrl, setQrDataUrl] = useState('');
  const [walletNotice, setWalletNotice] = useState(false);

  const handleQrGenerated = useCallback((dataUrl: string) => setQrDataUrl(dataUrl), []);

  if (!member) return null;

  const year = quota?.ano ?? new Date().getFullYear();
  const validUntil = quota?.dataFim ?? `31/12/${year}`;

  const handleDownload = () => {
    if (!qrDataUrl) return;
    const link = document.createElement('a');
    link.href = qrDataUrl;
    link.download = `cartao-acb-${member.numeroAssociado}.png`;
    link.click();
  };

  return (
    <div className="animate-fade-in px-5 pt-8 pb-8">
      <div className="flex flex-col items-center">
        <div className="w-full max-w-sm">
          <MembershipCard member={member} quota={quota} variant="full" onQrGenerated={handleQrGenerated} />
        </div>

        <p className="text-center text-sm text-ink-400 mt-6 px-6 leading-relaxed max-w-xs">
          Este cartão identifica-o como associado da Casa do Brasil de Viseu.
          Apresente-o para usufruir dos benefícios exclusivos dos associados.
        </p>

        <div className="mt-6 w-full max-w-sm space-y-2">
          <button
            onClick={() => setWalletNotice(true)}
            className="btn-secondary flex items-center justify-center gap-2"
          >
            <Wallet className="w-4 h-4" />
            Adicionar à Apple Wallet
          </button>
          {walletNotice && (
            <p className="text-xs text-ink-500 text-center bg-brand-900/60 border border-brand-700/40 rounded-lg p-3">
              Disponível numa próxima fase.
            </p>
          )}
          <button
            onClick={handleDownload}
            disabled={!qrDataUrl}
            className="btn-secondary flex items-center justify-center gap-2 disabled:opacity-50"
          >
            <Download className="w-4 h-4" />
            Descarregar QR Code
          </button>
        </div>

