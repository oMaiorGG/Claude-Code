import { useMemo, useState } from 'react';
import { useApp } from '@/context/AppContext';
import AdminSidebar, { type AdminPage } from '@/components/AdminSidebar';
import StatusBadge from '@/components/StatusBadge';
import SearchBar from '@/components/SearchBar';
import { Users, CreditCard, CalendarDays, Bell as BellIcon, Gift, Menu } from 'lucide-react';

interface AdminDashboardPageProps {
  onLogout: () => void;
}

function KpiCard({ label, value, icon: Icon }: { label: string; value: number | string; icon: typeof Users }) {
  return (
    <div className="card-surface p-4 flex items-center gap-3">
      <div className="w-10 h-10 rounded-lg bg-gold-500/10 flex items-center justify-center shrink-0">
        <Icon className="w-5 h-5 text-gold-300" />
      </div>
      <div>
        <p className="font-serif text-2xl font-semibold text-white leading-none">{value}</p>
        <p className="text-xs text-ink-400 mt-1">{label}</p>
      </div>
    </div>
  );
}

export default function AdminDashboardPage({ onLogout }: AdminDashboardPageProps) {
  const { members, quotas, activities, logout: appLogout } = useApp();
  const [current, setCurrent] = useState<AdminPage>('dashboard');
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [search, setSearch] = useState('');

  const handleLogout = () => {
    appLogout();
    onLogout();
  };

  const totalAssociados = members.length;
  const ativos = members.filter((m) => m.estadoAssociado === 'active').length;
  const quotasPendentes = quotas.filter((q) => q.estado === 'pendente' || q.estado === 'vencida').length;
  const proximasAtividades = activities.filter((a) => a.estadoInscricoes !== 'closed').length;

  const currentYear = new Date().getFullYear();
  const quotaByMember = useMemo(() => {
    const map = new Map<string, (typeof quotas)[number]>();
    quotas.forEach((q) => {
      if (q.ano === currentYear) map.set(q.associadoId, q);
    });
    return map;
  }, [quotas, currentYear]);

  const filteredMembers = useMemo(() => {
    const term = search.trim().toLowerCase();
    const list = term
      ? members.filter((m) =>
          m.nomeCompleto.toLowerCase().includes(term) || m.numeroAssociado.includes(term)
        )
      : members;
    return list.slice(-5).reverse();
  }, [members, search]);

  const upcomingActivities = activities.slice(0, 3);

  if (current !== 'dashboard') {
    return (
      <div className="min-h-screen flex bg-brand-950">
        <AdminSidebar current={current} onNavigate={setCurrent} onLogout={handleLogout} open={sidebarOpen} onClose={() => setSidebarOpen(false)} />
        <div className="flex-1 flex items-center justify-center p-8">
          <p className="text-ink-400 text-sm text-center max-w-xs">
            Esta secção fica pronta numa próxima fase.
          </p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen flex bg-brand-950">
      <AdminSidebar current={current} onNavigate={setCurrent} onLogout={handleLogout} open={sidebarOpen} onClose={() => setSidebarOpen(false)} />

      <div className="flex-1 min-w-0">
        <header className="sticky top-0 z-20 bg-brand-950/90 backdrop-blur-md border-b border-brand-800/40 px-5 h-16 flex items-center justify-between gap-4">
          <button onClick={() => setSidebarOpen(true)} className="lg:hidden text-ink-300 hover:text-white">
            <Menu className="w-5 h-5" />
          </button>
          <div className="flex-1 max-w-sm">
            <SearchBar value={search} onChange={setSearch} placeholder="Pesquisar associados..." />
          </div>
          <div className="hidden sm:flex items-center gap-2 shrink-0">
            <div className="w-9 h-9 rounded-full bg-brand-700 flex items-center justify-center text-xs font-semibold text-gold-200 border border-gold-500/30">
              A
            </div>
            <div className="text-right">
              <p className="text-xs font-medium text-white leading-none">Admin ACB</p>
              <p className="text-[10px] text-ink-500 mt-0.5">Administrador</p>
            </div>
          </div>
        </header>

        <main className="p-5 space-y-6">
          <div>
            <h1 className="font-serif text-2xl font-semibold text-white">Dashboard</h1>
            <p className="text-sm text-ink-400 mt-1">Visão geral da Associação Casa do Brasil</p>
          </div>

          <div className="grid grid-cols-2 lg:grid-cols-4 gap-3">
            <KpiCard label="Associados" value={totalAssociados} icon={Users} />
            <KpiCard label="Ativos" value={ativos} icon={CreditCard} />
            <KpiCard label="Quotas Pendentes" value={quotasPendentes} icon={Gift} />
            <KpiCard label="Próximas Atividades" value={proximasAtividades} icon={CalendarDays} />
          </div>

          <div className="grid lg:grid-cols-2 gap-4">
            <div className="card-surface p-5">
              <p className="section-title mb-4">Últimos Associados</p>
              <div className="space-y-2">
                {filteredMembers.map((m) => {
                  const q = quotaByMember.get(m.id);
                  return (
                    <div key={m.id} className="flex items-center justify-between py-2 border-b border-brand-800/40 last:border-0">
                      <div className="min-w-0">
                        <p className="text-sm text-white truncate">{m.nomeCompleto}</p>
                        <p className="text-xs text-ink-500">Nº {m.numeroAssociado}</p>
                      </div>
                      <div className="flex items-center gap-2 shrink-0">
                        <StatusBadge variant={m.estadoAssociado} size="sm" />
                        {q && <span className="text-xs text-ink-400">{q.ano}</span>}
                      </div>
                    </div>
                  );
                })}
                {filteredMembers.length === 0 && (
                  <p className="text-xs text-ink-500 py-4 text-center">Sem resultados.</p>
                )}
              </div>
            </div>

            <div className="card-surface p-5">
              <p className="section-title mb-4">Próximas Atividades</p>
              <div className="space-y-2">
                {upcomingActivities.map((a) => (
                  <div key={a.id} className="flex items-center justify-between py-2 border-b border-brand-800/40 last:border-0">
                    <div className="min-w-0">
                      <p className="text-sm text-white truncate">{a.titulo}</p>
                      <p className="text-xs text-ink-500">{a.data} · {a.hora}</p>
                    </div>
                    <span className="text-xs text-ink-400 shrink-0">{a.numeroInscritos}/{a.limiteParticipantes}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div className="card-surface p-5">
            <p className="section-title mb-4">Ações Rápidas</p>
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
              {[
                { label: 'Novo Associado', icon: Users },
                { label: 'Nova Atividade', icon: CalendarDays },
                { label: 'Novo Benefício', icon: Gift },
                { label: 'Nova Novidade', icon: BellIcon },
              ].map(({ label, icon: Icon }) => (
                <button
                  key={label}
                  disabled
                  title="Disponível numa próxima fase"
                  className="flex flex-col items-center gap-2 p-4 rounded-xl border border-brand-700/40
                             text-ink-500 cursor-not-allowed opacity-60"
                >
                  <Icon className="w-5 h-5" />
                  <span className="text-xs text-center">{label}</span>
                </button>
              ))}
            </div>
          </div>
        </main>
      </div>
    </div>
  );
}

