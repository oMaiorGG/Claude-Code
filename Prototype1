            <div className="flex items-center justify-between">
              <span className="text-ink-400">Estado</span>
              <StatusBadge variant={member.estadoAssociado} size="sm" />
            </div>
            <div className="flex items-center justify-between">
              <span className="text-ink-400">Ano</span>
              <span className="text-white font-medium">{year}</span>
            </div>
            <div className="flex items-center justify-between">
              <span className="text-ink-400">Validade</span>
              <span className="text-white font-medium">{validUntil}</span>
            </div>
            <div className="flex items-center justify-between">
              <span className="text-ink-400">Token</span>
              <span className="text-white font-medium font-mono text-xs">{member.cardToken}</span>
            </div>
          </div>
          <p className="text-xs text-ink-500 mt-4">
            O QR Code contém apenas um link seguro — não inclui dados pessoais.
